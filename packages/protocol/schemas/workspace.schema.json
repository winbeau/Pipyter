{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipyter.icthub.top/schemas/workspace.schema.json",
  "title": "Pipyter Workspace Summary",
  "type": "object",
  "required": ["protocol_version", "workspace_id", "project_id", "name", "root_name", "kernel_status", "connection_status", "open_documents"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "workspace_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "root_name": { "type": "string", "minLength": 1 },
    "kernel_status": { "enum": ["idle", "busy", "restarting", "dead"] },
    "connection_status": { "enum": ["connected", "connecting", "disconnected"] },
    "open_documents": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
